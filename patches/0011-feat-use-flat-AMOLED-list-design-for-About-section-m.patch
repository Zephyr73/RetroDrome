Subject: [PATCH 11/12] feat: use flat AMOLED list design for About section
 matching Metro

---
 .../fragments/about/AboutFragment.kt          |  8 ++---
 .../layout-xlarge/fragment_about_content.xml  | 34 ++++++++++++++++--
 .../res/layout/fragment_about_content.xml     | 35 +++++++++++++++++--
 app/src/main/res/values/strings.xml           |  2 +-
 4 files changed, 68 insertions(+), 11 deletions(-)

diff --git a/app/src/main/java/code/name/monkey/retromusic/fragments/about/AboutFragment.kt b/app/src/main/java/code/name/monkey/retromusic/fragments/about/AboutFragment.kt
index bebce6c6d..a0cb3d250 100644
--- a/app/src/main/java/code/name/monkey/retromusic/fragments/about/AboutFragment.kt
+++ b/app/src/main/java/code/name/monkey/retromusic/fragments/about/AboutFragment.kt
@@ -32,7 +32,7 @@ class AboutFragment : Fragment(R.layout.fragment_about), View.OnClickListener {
     override fun onViewCreated(view: View, savedInstanceState: Bundle?) {
         super.onViewCreated(view, savedInstanceState)
         _binding = FragmentAboutBinding.bind(view)
-        binding.aboutContent.cardOther.version.setSummary(getAppVersion())
+        binding.aboutContent.version.setSummary(getAppVersion())
         setUpView()
 
         binding.aboutContent.root.applyInsetter {
@@ -43,9 +43,9 @@ class AboutFragment : Fragment(R.layout.fragment_about), View.OnClickListener {
     }
 
     private fun setUpView() {
-        binding.aboutContent.cardOther.appGithub.setOnClickListener(this)
-        binding.aboutContent.cardOther.changelog.setOnClickListener(this)
-        binding.aboutContent.cardOther.openSource.setOnClickListener(this)
+        binding.aboutContent.appGithub.setOnClickListener(this)
+        binding.aboutContent.changelog.setOnClickListener(this)
+        binding.aboutContent.openSource.setOnClickListener(this)
     }
 
     override fun onClick(view: View) {
diff --git a/app/src/main/res/layout-xlarge/fragment_about_content.xml b/app/src/main/res/layout-xlarge/fragment_about_content.xml
index 64abb94bb..fdcb3821f 100644
--- a/app/src/main/res/layout-xlarge/fragment_about_content.xml
+++ b/app/src/main/res/layout-xlarge/fragment_about_content.xml
@@ -1,5 +1,6 @@
 <?xml version="1.0" encoding="utf-8"?>
 <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:orientation="vertical"
@@ -7,8 +8,35 @@
     android:paddingTop="8dp"
     android:paddingBottom="@dimen/mini_player_height">
 
-    <include
-        android:id="@+id/card_other"
-        layout="@layout/card_other" />
+    <code.name.monkey.retromusic.views.ListItemView
+        android:id="@+id/version"
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        app:listItemIcon="@drawable/ic_info_outline"
+        app:listItemTitle="@string/version" />
+
+    <code.name.monkey.retromusic.views.ListItemView
+        android:id="@+id/changelog"
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        app:listItemIcon="@drawable/ic_file_edit"
+        app:listItemSummary="@string/changelog_summary"
+        app:listItemTitle="@string/changelog" />
+
+    <code.name.monkey.retromusic.views.ListItemView
+        android:id="@+id/appGithub"
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        app:listItemIcon="@drawable/ic_github_circle"
+        app:listItemSummary="@string/git_hub_summary"
+        app:listItemTitle="@string/git_hub" />
+
+    <code.name.monkey.retromusic.views.ListItemView
+        android:id="@+id/openSource"
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        app:listItemIcon="@drawable/ic_license"
+        app:listItemSummary="@string/pref_summary_open_source_licences"
+        app:listItemTitle="@string/pref_title_open_source_licences" />
 
 </LinearLayout>
\ No newline at end of file
