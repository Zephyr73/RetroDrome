+package code.name.monkey.retromusic.db.catalog
+
+import androidx.room.Database
+import androidx.room.RoomDatabase
+
+@Database(
+    entities = [
+        UnifiedSongEntity::class,
+        UnifiedAlbumEntity::class,
+        UnifiedArtistEntity::class,
+        UnifiedGenreEntity::class
+    ],
+    version = 1,
+    exportSchema = false
+)
+abstract class MusicCatalogDatabase : RoomDatabase() {
+    abstract fun unifiedMusicDao(): UnifiedMusicDao
+}
diff --git a/app/src/main/java/code/name/monkey/retromusic/db/catalog/MusicCatalogSyncEngine.kt b/app/src/main/java/code/name/monkey/retromusic/db/catalog/MusicCatalogSyncEngine.kt
new file mode 100644
index 000000000..a0b122c2e
