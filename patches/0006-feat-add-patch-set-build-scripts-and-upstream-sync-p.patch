new file mode 100644
index 000000000..f5d41055e
--- /dev/null
+++ b/scripts/build-patched-apk.sh
@@ -0,0 +1,43 @@
+#!/usr/bin/env bash
+# RetroDrome - Clean Upstream Build with Patches Applied
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
+PATCH_DIR="${ROOT_DIR}/patches"
+
+cd "${ROOT_DIR}"
+
+BASE_REF="${1:-upstream/dev}"
+BUILD_TYPE="${2:-Release}" # Release or Debug
+
+echo "==> Preparing clean build branch from ${BASE_REF}..."
+git fetch upstream 2>/dev/null || true
+
+BUILD_BRANCH="retrodrome-build-temp-$(date +%s)"
+git checkout -b "${BUILD_BRANCH}" "${BASE_REF}"
+
+cleanup() {
+    echo "==> Cleaning up temporary build branch..."
+    git reset --hard 2>/dev/null || true
+    git clean -fd -e patches -e scripts 2>/dev/null || true
+    git checkout - 2>/dev/null || true
+    git branch -D "${BUILD_BRANCH}" 2>/dev/null || true
+}
+trap cleanup EXIT
+
+echo "==> Applying RetroDrome patches..."
+for patch in "${PATCH_DIR}"/*.patch; do
+    echo "  -> Applying $(basename "${patch}")..."
+    git apply "${patch}"
+done
+
+echo "==> Building F-Droid ${BUILD_TYPE} APK..."
+./gradlew ":app:assembleFdroid${BUILD_TYPE}"
+
+APK_PATH="app/build/outputs/apk/fdroid/${BUILD_TYPE,,}/app-fdroid-${BUILD_TYPE,,}.apk"
+if [ -f "${APK_PATH}" ]; then
+    echo "==> SUCCESS! Output APK created at: ${APK_PATH}"
+else
+    echo "==> Build completed. Check app/build/outputs/apk/fdroid/ for artifacts."
+fi
diff --git a/scripts/export-patches.ps1 b/scripts/export-patches.ps1
new file mode 100644
index 000000000..3c2f341d7
--- /dev/null
+++ b/scripts/export-patches.ps1
@@ -0,0 +1,25 @@
+# RetroDrome - Export Feature Commits to patches/ (PowerShell)
+param (
+    [string]$BaseRef = "upstream/dev"
+)
+
+$ErrorActionPreference = "Stop"
+
+$scriptDir = Split-Path -Parent $MyInvocation.MyCommand.Path
+$rootDir = Split-Path -Parent $scriptDir
+$patchDir = Join-Path $rootDir "patches"
+
+Set-Location $rootDir
+
+Write-Host "==> Exporting commits on top of $BaseRef to $patchDir..." -ForegroundColor Cyan
+
+Get-ChildItem -Path $patchDir -Filter "*.patch" -ErrorAction SilentlyContinue | Remove-Item -Force
+
+git format-patch -o $patchDir "$BaseRef..HEAD"
+if ($LASTEXITCODE -ne 0) {
+    Write-Error "Failed to export patches from $BaseRef"
+    exit $LASTEXITCODE
+}
+
+Write-Host "==> Patches exported successfully:" -ForegroundColor Green
+Get-ChildItem -Path $patchDir -Filter "*.patch" | Format-Table Name, Length -AutoSize
diff --git a/scripts/export-patches.sh b/scripts/export-patches.sh
new file mode 100644
index 000000000..a0806816e
--- /dev/null
+++ b/scripts/export-patches.sh
@@ -0,0 +1,18 @@
+#!/usr/bin/env bash
+# RetroDrome - Export Feature Commits to patches/
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
+PATCH_DIR="${ROOT_DIR}/patches"
+
+cd "${ROOT_DIR}"
+
+BASE_REF="${1:-upstream/dev}"
+
+echo "==> Exporting commits on top of ${BASE_REF} to ${PATCH_DIR}..."
+rm -f "${PATCH_DIR}"/*.patch
+git format-patch -o "${PATCH_DIR}" "${BASE_REF}..HEAD"
+
+echo "==> Patches exported successfully:"
+ls -l "${PATCH_DIR}"/*.patch
