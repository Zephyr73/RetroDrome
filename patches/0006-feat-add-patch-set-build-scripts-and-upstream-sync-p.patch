diff --git a/scripts/apply-patches.ps1 b/scripts/apply-patches.ps1
new file mode 100644
index 000000000..22780cced
--- /dev/null
+++ b/scripts/apply-patches.ps1
@@ -0,0 +1,51 @@
+# RetroDrome - Apply Patch Layer onto Upstream RetroMusic (PowerShell)
+$ErrorActionPreference = "Stop"
+
+$scriptDir = Split-Path -Parent $MyInvocation.MyCommand.Path
+$rootDir = Split-Path -Parent $scriptDir
+$patchDir = Join-Path $rootDir "patches"
+
+Set-Location $rootDir
+
+$patches = Get-ChildItem -Path $patchDir -Filter "*.patch" | Sort-Object Name
+if ($patches.Count -eq 0) {
+    Write-Error "No patch files found in $patchDir"
+    exit 1
+}
+
+# Check if all patches are already applied
+$allAlreadyApplied = $true
+foreach ($patch in $patches) {
+    git apply --check --reverse $patch.FullName 2>$null
+    if ($LASTEXITCODE -ne 0) {
+        $allAlreadyApplied = $false
+        break
+    }
+}
+
+if ($allAlreadyApplied) {
+    Write-Host "==> All RetroDrome patches are already applied to the current tree." -ForegroundColor Yellow
+    exit 0
+}
+
+Write-Host "==> Checking patches against current working tree..." -ForegroundColor Cyan
+foreach ($patch in $patches) {
+    Write-Host "  -> Validating $($patch.Name)..."
+    git apply --check $patch.FullName
+    if ($LASTEXITCODE -ne 0) {
+        Write-Error "Validation failed for $($patch.Name). Make sure you are on a clean upstream commit."
+        exit $LASTEXITCODE
+    }
+}
+
+Write-Host "==> Applying patches..." -ForegroundColor Cyan
+foreach ($patch in $patches) {
+    Write-Host "  -> Applying $($patch.Name)..."
+    git apply $patch.FullName
+    if ($LASTEXITCODE -ne 0) {
+        Write-Error "Failed to apply $($patch.Name)"
+        exit $LASTEXITCODE
+    }
+}
+
+Write-Host "==> All RetroDrome patches applied successfully!" -ForegroundColor Green
diff --git a/scripts/apply-patches.sh b/scripts/apply-patches.sh
new file mode 100644
index 000000000..d5910170d
--- /dev/null
+++ b/scripts/apply-patches.sh
@@ -0,0 +1,42 @@
+#!/usr/bin/env bash
+# RetroDrome - Apply Patch Layer onto Upstream RetroMusic
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
+PATCH_DIR="${ROOT_DIR}/patches"
+
+cd "${ROOT_DIR}"
+
+if [ ! -d "${PATCH_DIR}" ] || [ -z "$(ls -A "${PATCH_DIR}"/*.patch 2>/dev/null)" ]; then
+    echo "Error: No patch files found in ${PATCH_DIR}"
+    exit 1
+fi
+
+# Check if all patches are already applied
+ALL_APPLIED=true
+for patch in "${PATCH_DIR}"/*.patch; do
+    if ! git apply --check --reverse "${patch}" 2>/dev/null; then
+        ALL_APPLIED=false
+        break
+    fi
+done
+
+if [ "$ALL_APPLIED" = true ]; then
+    echo "==> All RetroDrome patches are already applied to the current tree."
+    exit 0
+fi
+
+echo "==> Checking patches against current working tree..."
+for patch in "${PATCH_DIR}"/*.patch; do
+    echo "  -> Validating $(basename "${patch}")..."
+    git apply --check "${patch}"
+done
+
+echo "==> Applying patches..."
+for patch in "${PATCH_DIR}"/*.patch; do
+    echo "  -> Applying $(basename "${patch}")..."
+    git apply "${patch}"
+done
+
+echo "==> All RetroDrome patches applied successfully!"
diff --git a/scripts/build-patched-apk.ps1 b/scripts/build-patched-apk.ps1
new file mode 100644
index 000000000..0f6c7800a
--- /dev/null
+++ b/scripts/build-patched-apk.ps1
@@ -0,0 +1,60 @@
+# RetroDrome - Clean Upstream Build with Patches Applied (PowerShell)
+param (
+    [string]$BaseRef = "upstream/dev",
+    [string]$BuildType = "Debug" # Debug or Release
+)
+
+$ErrorActionPreference = "Stop"
+
+$scriptDir = Split-Path -Parent $MyInvocation.MyCommand.Path
+$rootDir = Split-Path -Parent $scriptDir
+$patchDir = Join-Path $rootDir "patches"
+
+Set-Location $rootDir
+
+Write-Host "==> Preparing clean build branch from $BaseRef..." -ForegroundColor Cyan
+git fetch upstream 2>&1 | Out-Null
+
+$timestamp = [DateTimeOffset]::UtcNow.ToUnixTimeSeconds()
+$buildBranch = "retrodrome-build-temp-$timestamp"
+
+$currentBranch = (git branch --show-current).Trim()
+
+try {
+    git checkout --quiet -b $buildBranch $BaseRef 2>&1 | Out-Null
+    if ($LASTEXITCODE -ne 0) {
+        throw "Failed to checkout base ref $BaseRef"
+    }
+
+    $patches = Get-ChildItem -Path $patchDir -Filter "*.patch" | Sort-Object Name
+    Write-Host "==> Applying RetroDrome patches..." -ForegroundColor Cyan
+    foreach ($patch in $patches) {
+        Write-Host "  -> Applying $($patch.Name)..."
+        git apply $patch.FullName
+        if ($LASTEXITCODE -ne 0) {
+            throw "Failed to apply patch $($patch.Name)"
+        }
+    }
+
+    $capitalizedType = (Get-Culture).TextInfo.ToTitleCase($BuildType.ToLower())
+    Write-Host "==> Building F-Droid $capitalizedType APK..." -ForegroundColor Cyan
+    ./gradlew ":app:assembleFdroid$capitalizedType"
+    if ($LASTEXITCODE -ne 0) {
+        throw "Gradle build failed"
+    }
+
+    $lowerType = $BuildType.ToLower()
+    $apkPath = "app/build/outputs/apk/fdroid/$lowerType/app-fdroid-$lowerType.apk"
+    if (Test-Path $apkPath) {
+        Write-Host "==> SUCCESS! Output APK created at: $apkPath" -ForegroundColor Green
+    } else {
+        Write-Host "==> Build completed. Check app/build/outputs/apk/fdroid/ for artifacts." -ForegroundColor Yellow
+    }
+}
+finally {
+    Write-Host "==> Cleaning up temporary build branch..." -ForegroundColor Gray
+    git reset --hard 2>&1 | Out-Null
+    git clean -fd -e patches -e scripts 2>&1 | Out-Null
+    git checkout --quiet $currentBranch 2>&1 | Out-Null
+    git branch -D $buildBranch 2>&1 | Out-Null
+}
