     private val subsonicToMetroMap = ConcurrentHashMap<String, Long>()
     private val metroToSubsonicMap = ConcurrentHashMap<Long, String>()
+    private val metroToLocalSongMap = ConcurrentHashMap<Long, Long>()
+    private val metroToLocalAlbumMap = ConcurrentHashMap<Long, Long>()
+    private val metroToLocalArtistMap = ConcurrentHashMap<Long, Long>()
     private val songCache = ConcurrentHashMap<Long, SubsonicSong>()
 
     fun registerMapping(metroId: Long, subsonicId: String) {
@@ -27,6 +30,30 @@ object SubsonicMapper {
         }
     }
 
+    fun registerLocalMapping(metroId: Long, localMediaStoreId: Long) {
+        if (localMediaStoreId > 0) {
+            metroToLocalSongMap[metroId] = localMediaStoreId
+        }
+    }
+
+    fun toLocalMediaStoreId(metroId: Long): Long? = metroToLocalSongMap[metroId]
+
+    fun registerLocalAlbumMapping(metroId: Long, localAlbumId: Long) {
+        if (localAlbumId > 0) {
+            metroToLocalAlbumMap[metroId] = localAlbumId
+        }
+    }
+
+    fun toLocalAlbumId(metroId: Long): Long? = metroToLocalAlbumMap[metroId]
+
+    fun registerLocalArtistMapping(metroId: Long, localArtistId: Long) {
+        if (localArtistId > 0) {
+            metroToLocalArtistMap[metroId] = localArtistId
+        }
+    }
+
+    fun toLocalArtistId(metroId: Long): Long? = metroToLocalArtistMap[metroId]
+
     fun toMetroId(subsonicId: String): Long {
         if (subsonicId.isBlank()) return -1L
         subsonicToMetroMap[subsonicId]?.let { return it }
diff --git a/app/src/main/java/code/name/monkey/retromusic/repository/Repository.kt b/app/src/main/java/code/name/monkey/retromusic/repository/Repository.kt
index 90c462a58..ec60093ef 100644
--- a/app/src/main/java/code/name/monkey/retromusic/repository/Repository.kt
+++ b/app/src/main/java/code/name/monkey/retromusic/repository/Repository.kt
@@ -133,9 +133,45 @@ class RealRepository(
         }
     }
 
+    private var hasPrewarmed = false
+    private suspend fun prewarmMappings() {
+        if (hasPrewarmed) return
+        hasPrewarmed = true
+        try {
+            for (song in catalogDao.getAllSongs()) {
+                if (song.localMediaStoreId != null && song.localMediaStoreId > 0) {
+                    code.name.monkey.retromusic.network.subsonic.SubsonicMapper.registerLocalMapping(song.id, song.localMediaStoreId)
+                }
+                if (!song.subsonicId.isNullOrBlank()) {
+                    code.name.monkey.retromusic.network.subsonic.SubsonicMapper.registerMapping(song.id, song.subsonicId)
+                }
+            }
+            for (album in catalogDao.getAllAlbums()) {
+                if (album.localAlbumId != null && album.localAlbumId > 0) {
+                    code.name.monkey.retromusic.network.subsonic.SubsonicMapper.registerLocalAlbumMapping(album.id, album.localAlbumId)
+                }
+                if (!album.subsonicAlbumId.isNullOrBlank()) {
+                    code.name.monkey.retromusic.network.subsonic.SubsonicMapper.registerMapping(album.id, album.subsonicAlbumId)
+                }
+            }
+            for (artist in catalogDao.getAllArtists()) {
+                if (artist.localArtistId != null && artist.localArtistId > 0) {
+                    code.name.monkey.retromusic.network.subsonic.SubsonicMapper.registerLocalArtistMapping(artist.id, artist.localArtistId)
+                }
+                if (!artist.subsonicArtistId.isNullOrBlank()) {
+                    code.name.monkey.retromusic.network.subsonic.SubsonicMapper.registerMapping(artist.id, artist.subsonicArtistId)
+                }
+            }
+        } catch (e: Exception) {
+            logE("RealRepository: prewarmMappings failed: ${e.message}")
+        }
+    }
+
     private suspend fun ensureCatalogLoaded() {
         if (catalogDao.getSongCount() == 0) {
             syncEngine.syncAll(songRepository, albumRepository, artistRepository, genreRepository)
+        } else {
+            prewarmMappings()
         }
     }
 
